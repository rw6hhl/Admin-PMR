<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_blue" />

        <!-- ============ Смена пароля ============ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Смена пароля"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/passCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_current_pass"
            android:inputType="textPassword"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/passNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_new_pass"
            android:inputType="textPassword"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/passConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_confirm_pass"
            android:inputType="textPassword"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/requirePassBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_password_title"
            android:textSize="16sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/checkSystemBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_check_title"
            android:textSize="16sp"
            android:checked="true" />

        <!-- ============ Расширенная диагностика ============ -->

        <CheckBox
            android:id="@+id/diagBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Расширенная диагностика (для отладки)"
            android:textSize="16sp"
            android:checked="true" />

        <!-- ============ Источник списка абонентов ============ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Источник списка абонентов"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/listSourceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioListServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Список от сервера (cmd=234)"
                android:textSize="16sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioListLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Список из list.txt (без запроса серверу)"
                android:textSize="16sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnLoadList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_load_list"
            android:backgroundTint="@color/c_blue"
            android:textColor="@color/c_white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <!-- ============ Регистрационные данные ============ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Регистрационные данные"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="Priznak_pmr  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPriznak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="MyMailIndex  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regMailIndex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="MyPChannel   ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPChannel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="ip_server  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regIpServer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="PORT_prm  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPortPrm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="PORT_prd  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPortPrd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="Call  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regCallsign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="QTH  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_save"
            android:backgroundTint="@color/c_green"
            android:textColor="@color/c_white"
            android:textSize="18sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_26_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn26"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_26_off"
            android:textSize="20sp"
            android:backgroundTint="@color/c_red"
            android:textColor="@color/c_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_log_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_log_open"
            android:backgroundTint="@color/c_blue"
            android:textColor="@color/c_white"
            android:textSize="16sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

    </LinearLayout>
</ScrollView>