<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/c_bg">

    <TextView
        android:id="@+id/listTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/list_title"
        android:textColor="@color/c_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@color/c_blue" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_settings"
        android:backgroundTint="@color/c_green"
        android:textColor="@color/c_white"
        android:textSize="18sp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:clipToPadding="false" />

    <!-- Индикаторы состояния (передача/приём) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ind_tx"
            android:textSize="14sp"
            android:textColor="@color/c_black"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/imgTx"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@color/c_red"
            android:layout_marginEnd="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ind_rx"
            android:textSize="14sp"
            android:textColor="@color/c_black"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/imgRx"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@color/c_green" />
    </LinearLayout>

    <!-- Кнопка PTT — нажать и держать для передачи -->
    <Button
        android:id="@+id/btnPtt"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="4dp"
        android:text="@string/btn_ptt"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/c_white"
        android:backgroundTint="@color/c_blue" />

    <!-- Кнопка загрузки list.txt -->
    <Button
        android:id="@+id/btnLoadList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_load_list"
        android:textSize="16sp"
        android:textColor="@color/c_white"
        android:backgroundTint="@color/c_green"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />

</LinearLayout>